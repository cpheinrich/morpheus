{
  "name": "morpheus-kit",
  "version": "0.1.0",
  "description": "An operating system for building and running companies, designed to be operated by agents.",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "morpheus": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./pm": "./dist/pm/index.js",
    "./inbox": "./dist/inbox/index.js",
    "./heartbeat": "./dist/heartbeat/index.js",
    "./brand": "./dist/brand/index.js",
    "./access": "./dist/access/index.js",
    "./firebase": "./dist/firebase/index.js",
    "./hq": "./dist/hq/index.js",
    "./hq-search": "./dist/hq-search/index.js",
    "./hq-search/build": "./dist/hq-search/build.js",
    "./hq-search/pdf": "./dist/hq-search/pdf.js",
    "./hq-search/react": "./dist/hq-search/react.js",
    "./registry": "./dist/registry/index.js",
    "./doctor": "./dist/doctor/index.js",
    "./codebase-memory": "./dist/codebase-memory.js",
    "./self": "./dist/self.js",
    "./design": "./dist/design/index.js",
    "./team": "./dist/team/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "pnpm compile && firebase emulators:exec --only firestore --project morpheus-rules-test 'node --test tests/firestore-rules.test.mjs'",
    "lint": "eslint src",
    "morpheus": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "jose": "^6.2.5",
    "minisearch": "^7.2.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "pdf-parse": "^2.4.5",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "pdf-parse": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.9.1",
    "firebase": "^12.17.0",
    "js-yaml": "^5.2.2",
    "jsdom": "^26.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpheinrich/morpheus.git"
  }
}
