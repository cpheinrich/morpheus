{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/plugins/factory/scripts/claude-hook.mjs\" SessionStart",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/plugins/factory/scripts/claude-hook.mjs\" UserPromptSubmit",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/plugins/factory/scripts/claude-hook.mjs\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/plugins/factory/scripts/claude-hook.mjs\" SessionEnd",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
