#!/bin/bash
# cd-v2-common.sh.template — shared parameter resolution for public Morpheus CD V2 host wiring.
#
# TEMPLATE. An operator MUST render every ____ placeholder with concrete reviewed
# absolute paths/digests before use. This file refuses to run while any placeholder
# is unresolved. Nothing here is installed or activated.
#
# Rendered (operator-supplied, immutable, reviewed) parameters:
#   CD_V2_CONFIG_PATH   absolute path to the consumer's .morpheus/cd.json
#   CD_V2_SOURCE_DIR    consumer app source checkout (distinct from the runtime checkout)
#   CD_V2_RUNTIME_DIR   immutable trusted runtime/control checkout (public Morpheus commit)
#   CD_V2_RUNTIME_DIGEST  sha256:... of the runtime CLI entry file dist/cli/index.js
#   CD_V2_CONFIG_DIGEST   sha256:... of the config file (pinned at review time)
#   CD_V2_CRED_WRAPPER  EXEC wrapper: it loads credential VALUES into its own
#                       environment and execs "$@" as a child. Sourcing or
#                       exporting names only is insufficient.
#
# The controller CLI lives at dist/cli/index.js in the Morpheus repository root
# (package.json "bin": "./dist/cli/index.js") — NOT tooling/dist/cli/index.js.
# CLI grammar (src/cd/cli.ts cd()): `cd tick|worker [flags]`.

set -euo pipefail

CD_V2_CONFIG_PATH="____/.morpheus/cd.json"
CD_V2_SOURCE_DIR="____/consumer-source-checkout"
CD_V2_RUNTIME_DIR="____/public-runtime-checkout"
CD_V2_RUNTIME_DIGEST="sha256:____"
CD_V2_CONFIG_DIGEST="sha256:____"
CD_V2_CRED_WRAPPER="____/credential-exec-wrapper.sh"
CD_V2_TICK_OBSERVE="0" # rendered to "0" or "1" by the operator; not an env override

fail() { printf 'cd-v2-common: %s\n' "$1" >&2; exit 2; }

for name in CD_V2_CONFIG_PATH CD_V2_SOURCE_DIR CD_V2_RUNTIME_DIR CD_V2_CRED_WRAPPER; do
  value="${!name:-}"
  [ -n "$value" ] || fail "$name is unset"
  case "$value" in
    *____*) fail "$name is still a placeholder; render the template before running" ;;
    /*) ;;
    *) fail "$name must be an absolute path: $value" ;;
  esac
done

for name in CD_V2_RUNTIME_DIGEST CD_V2_CONFIG_DIGEST; do
  value="${!name:-}"
  case "$value" in
    sha256:[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
    *) fail "$name must be a pinned sha256:<64 hex> literal, got: ${value:-empty}" ;;
  esac
done

[ -f "$CD_V2_CONFIG_PATH" ] || fail "config not found: $CD_V2_CONFIG_PATH"
[ -d "$CD_V2_SOURCE_DIR" ] || fail "source dir not found: $CD_V2_SOURCE_DIR"
[ -d "$CD_V2_RUNTIME_DIR" ] || fail "runtime dir not found: $CD_V2_RUNTIME_DIR"
[ -x "$CD_V2_CRED_WRAPPER" ] || fail "credential wrapper is not executable: $CD_V2_CRED_WRAPPER"

CLI="$CD_V2_RUNTIME_DIR/dist/cli/index.js"
[ -f "$CLI" ] || fail "runtime CLI missing at dist/cli/index.js: $CD_V2_RUNTIME_DIR (Morpheus has no tooling/dist/cli/index.js)"

[ "$CD_V2_SOURCE_DIR" != "$CD_V2_RUNTIME_DIR" ] \
  || fail "source and runtime checkouts must be distinct directories"

file_digest() { printf 'sha256:%s' "$(shasum -a 256 "$1" | cut -d' ' -f1)"; }

actual_runtime_digest="$(file_digest "$CLI")"
[ "$actual_runtime_digest" = "$CD_V2_RUNTIME_DIGEST" ] \
  || fail "runtime digest $actual_runtime_digest != pinned $CD_V2_RUNTIME_DIGEST; refusing to invoke"

actual_config_digest="$(file_digest "$CD_V2_CONFIG_PATH")"
[ "$actual_config_digest" = "$CD_V2_CONFIG_DIGEST" ] \
  || fail "config digest $actual_config_digest != pinned $CD_V2_CONFIG_DIGEST; refusing to invoke"

# cd_v2 <cd-subcommand args...>: the credential EXEC wrapper runs the controller
# as its child with loaded credential values in the child environment; the
# wrapper never prints them and this script never logs its environment.
cd_v2() {
  exec "$CD_V2_CRED_WRAPPER" "$CLI" cd "$@"
}